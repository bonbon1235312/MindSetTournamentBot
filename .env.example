# ── Discord ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash-command deployment to one guild during development.
# Leave blank for global deployment (production, slow propagation).
DISCORD_GUILD_ID=

# ── Database ──────────────────────────────────────────────────────────────
# postgres://user:password@host:port/database
DATABASE_URL=

# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_TIMEZONE=Europe/London

# Unique identifier for this bot process. Required so the database-backed
# scheduler can tell worker instances apart when claiming jobs. Any stable
# string is fine (hostname, container ID, "worker-1", etc).
SCHEDULER_WORKER_ID=worker-1

# Where rendered tournament graphics (PNG) are cached on disk before being
# uploaded to Discord.
GRAPHICS_CACHE_DIR=./data/graphics

# "guild" deploys slash commands instantly to DISCORD_GUILD_ID (development).
# "global" deploys to every guild the bot is in (production, propagation
# can take up to an hour).
COMMAND_DEPLOY_MODE=guild
